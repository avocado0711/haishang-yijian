# Server-side only. Never expose these keys with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash

# OpenAI-compatible image generation endpoint.
# Example: https://provider.example.com/v1
IMAGE_API_KEY=replace-with-image-key
IMAGE_API_BASE_URL=
IMAGE_MODEL_FAST=flux-schnell
IMAGE_MODEL_BALANCED=seedream-4
IMAGE_MODEL_QUALITY=gpt-image-1
